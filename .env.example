# EV Charging Locator - Environment Variables Example
# Copy this file to .env and fill in your values

# ===== FRONTEND (Required) =====
# Firebase Configuration (from Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Google Maps API Key (Required for maps, routing and places)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===== BACKEND (Optional for advanced features) =====
# Firebase Admin SDK Service Account (JSON string)
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# ML Service URL (if running separately)
ML_SERVICE_URL=http://localhost:8001

# ===== DEVELOPMENT =====
NODE_ENV=development
